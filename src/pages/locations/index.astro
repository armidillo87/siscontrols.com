---
import BaseLayout from '@/layouts/BaseLayout.astro';
import cities from '@/data/cities.json';

const title = "Regional Industrial Hubs | Intermountain West Control Panel Sourcing";
const description = "Serving industrial manufacturing, AI data centers, and food processing facilities across Idaho, Utah, and the Intermountain West. Boise, Kuna, Twin Falls, and Salt Lake City.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Sawtooth Industrial Systems",
    "url": "https://siscontrols.com",
    "areaServed": cities.map((c) => ({
      "@type": "City",
      "name": `${c.city}, ${c.state}`
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://siscontrols.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Locations",
        "item": "https://siscontrols.com/locations/"
      }
    ]
  }
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-[#0B1120] to-[#0F172A] pt-8 pb-16 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-xs font-mono text-slate-400">
          <li><a class="hover:text-amber-400 transition-colors" href="/">Home</a></li>
          <li>/</li>
          <li aria-current="page" class="text-amber-400 font-semibold">Locations</li>
        </ol>
      </nav>
      <div class="space-y-4 max-w-4xl">
        <div class="flex flex-wrap items-center gap-2">
          <span class="sis-badge sis-badge--amber">INTERMOUNTAIN WEST COVERAGE</span>
          <span class="sis-badge sis-badge--cyan">10 REGIONAL INDUSTRIAL HUBS</span>
          <span class="sis-badge sis-badge--emerald">RAPID FIELD DISPATCH</span>
        </div>
        <!-- Single H1 -->
        <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white uppercase leading-tight">
          Regional Industrial Hubs &amp; Automation Sourcing
        </h1>
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed font-normal">
          From semiconductor cleanrooms in Boise and hyperscale data halls in Kuna to sanitary food processing in the Magic Valley, Sawtooth Industrial Systems delivers build-to-print UL 508A panels engineered for regional micro-climates.
        </p>
      </div>
    </div>
  </section>

  <!-- Industrial Hubs Grid -->
  <section class="py-16 bg-[#0F172A] border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      <div class="max-w-3xl space-y-2">
        <span class="text-xs font-mono font-bold text-amber-500 uppercase tracking-widest">Active Service Territories</span>
        <h2 class="text-2xl sm:text-3xl font-black text-white uppercase tracking-tight">
          Southern Idaho &amp; Northern Utah Industrial Corridor
        </h2>
        <p class="text-sm text-slate-300 leading-relaxed">
          Select an industrial territory to review localized elevation derating specifications, municipal utility compliance guidelines, and active project anchors.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {cities.map((city) => (
          <div class="sis-card-enclosure p-6 space-y-4 flex flex-col justify-between">
            <div class="space-y-3">
              <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                <div>
                  <h3 class="text-xl font-black text-white uppercase">
                    {city.city}, {city.state}
                  </h3>
                  <div class="text-xs font-mono text-amber-400 mt-0.5">{city.county}</div>
                </div>
                <span class="text-xs font-mono bg-slate-900 px-2.5 py-1 rounded border border-slate-800 text-slate-300">
                  {city.elevation}
                </span>
              </div>

              <div>
                <span class="text-[10px] font-mono uppercase tracking-widest text-slate-400">Primary Industrial Focus</span>
                <p class="text-xs font-bold text-slate-200 mt-0.5">{city.industrialHub}</p>
              </div>

              <div class="space-y-1">
                <span class="text-[10px] font-mono uppercase tracking-widest text-slate-400">Key Manufacturing Sectors</span>
                <ul class="text-xs text-slate-300 space-y-1">
                  {city.majorIndustries.slice(0, 2).map((ind) => (
                    <li class="flex items-start gap-1.5">
                      <span class="text-amber-500 mt-0.5">•</span>
                      <span>{ind}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="pt-4 border-t border-slate-800 flex items-center justify-between">
              <a href={`/locations/${city.slug}/`} class="text-xs font-bold text-amber-400 hover:text-amber-300 uppercase tracking-wider flex items-center gap-1">
                VIEW TERRITORY SPECS
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </a>
              <a href="/rfq/" class="text-xs font-mono text-slate-400 hover:text-white uppercase">
                QUOTE →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Regional Capabilities Callout Banner -->
  <section class="py-16 bg-[#0B1120] border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="p-8 rounded-lg bg-slate-900 border border-slate-800 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-2 max-w-2xl">
          <span class="text-xs font-mono font-bold text-cyan-400 uppercase tracking-wider">Fast-Track Engineering Response</span>
          <h2 class="text-xl sm:text-2xl font-black text-white uppercase">
            Need a Control Panel Sourced or Quoted in Your District?
          </h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Our Boise operations desk coordinates submittal reviews, BOM optimization, and certified UL 508A partner fabrication with rapid 24 to 48 hour turnaround on technical proposals.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a href="/rfq/" class="btn-sis-rfq px-6 py-3 text-xs">
            SUBMIT ENGINEERING PRINTS →
          </a>
          <a href="/contact/" class="btn-sis-secondary px-6 py-3 text-xs">
            DISPATCH DESK: (208) 555-0190
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
