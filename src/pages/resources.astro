<td class="py-3 px-4 text-slate-300">Allen-Bradley 140G / Eaton Cutler-Hammer</td>
<td class="py-3 px-4 text-cyan-300">ABB SACE Tmax XT / Schneider PowerPact</td>
<td class="py-3 px-4 text-amber-400">In stock vs. 16-24 weeks</td>
<td class="py-3 px-4 text-emerald-400">-18% to -24%</td>
</tr>
<tr class="hover:bg-slate-800/40">
<td class="py-3 px-4 font-bold text-white">Variable Frequency Drive (VFD 15HP-50HP)</td>
<td class="py-3 px-4 text-slate-300">Rockwell PowerFlex 525 / 753</td>
<td class="py-3 px-4 text-cyan-300">ABB ACS580 / WEG CFW500 Series</td>
<td class="py-3 px-4 text-amber-400">1-3 days vs. 18-30 weeks</td>
<td class="py-3 px-4 text-emerald-400">-22% to -30%</td>
</tr>
<tr class="hover:bg-slate-800/40">
<td class="py-3 px-4 font-bold text-white">Compact / Micro PLC Controller</td>
<td class="py-3 px-4 text-slate-300">Allen-Bradley CompactLogix 5069</td>
<td class="py-3 px-4 text-cyan-300">Siemens S7-1200 / AutomationDirect BRX</td>
<td class="py-3 px-4 text-amber-400">Immediate vs. 12-20 weeks</td>
<td class="py-3 px-4 text-emerald-400">-35% to -50%</td>
</tr>
<tr class="hover:bg-slate-800/40">
<td class="py-3 px-4 font-bold text-white">High-Fault Power Distribution Blocks</td>
<td class="py-3 px-4 text-slate-300">Allen-Bradley 1492 Series</td>
