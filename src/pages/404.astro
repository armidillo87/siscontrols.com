---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout 
  title="404 - Page Not Found | Sawtooth Industrial Systems" 
  description="Signal Loss - Requested route does not exist."
>
  <div class="min-h-[70vh] flex items-center justify-center py-20 px-4">
    <div class="sis-card-enclosure max-w-lg w-full p-8 text-center space-y-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-amber-500/10 border border-amber-500/20 text-amber-400 font-mono text-xs">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        STATUS 404: CIRCUIT BREAK DETECTED
      </div>

      <h1 class="text-4xl sm:text-5xl font-black text-white uppercase tracking-tight">Signal Loss</h1>
      
      <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
        The requested URL path or schematic route does not exist or has been relocated to an updated capability page.
      </p>

      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="/" class="btn-sis-rfq w-full sm:w-auto text-xs py-3 px-6 text-center">
          RETURN TO HOMEPAGE &rarr;
        </a>
        <a href="/rfq/" class="btn-sis-secondary w-full sm:w-auto text-xs py-3 px-6 text-center">
          START PANEL RFQ &rarr;
        </a>
      </div>

      <div class="pt-4 border-t border-slate-800 text-[11px] font-mono text-slate-400">
        Need rapid component sourcing or RFQ assistance? Contact our sourcing desk at <a href="mailto:rfq@siscontrols.com" class="text-amber-400 hover:underline">rfq@siscontrols.com</a>
      </div>
    </div>
  </div>
</BaseLayout>
