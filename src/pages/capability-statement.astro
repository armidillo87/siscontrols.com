---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = "Government & Prime Contractor Capability Statement | Sawtooth";
const description = "Official Capability Statement for Sawtooth Industrial Systems LLC. CAGE: 9Z4A2, DUNS: 11-892-4821, Northwest Mountain MSDC Certified MBE, NAICS 335314. UL 508A control panels and data center skids.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "GovernmentOrganization",
    "name": "Sawtooth Industrial Systems LLC - Federal & Prime Contracting Desk",
    "url": "https://siscontrols.com/capability-statement/",
    "telephone": "+1-208-555-0190",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1111 S Orchard St, Ste 218",
      "addressLocality": "Boise",
      "addressRegion": "ID",
      "postalCode": "83705",
      "addressCountry": "US"
    },
    "description": "Federal and prime contractor capability statement for certified MBE industrial control panel manufacturing and data center power skid engineering."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://siscontrols.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Capability Statement",
        "item": "https://siscontrols.com/capability-statement/"
      }
    ]
  }
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <!-- Hero / Header Section -->
  <section class="bg-gradient-to-b from-[#0B1120] to-[#0F172A] pt-8 pb-12 border-b border-slate-800">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-xs font-mono text-slate-400">
          <li><a class="hover:text-amber-400 transition-colors" href="/">Home</a></li>
          <li>/</li>
          <li aria-current="page" class="text-amber-400 font-semibold">Capability Statement</li>
        </ol>
      </nav>

      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
        <div>
          <div class="flex flex-wrap items-center gap-2 mb-2">
            <span class="sis-badge sis-badge--amber">CAGE: 9Z4A2</span>
            <span class="sis-badge sis-badge--emerald">CERTIFIED MBE: NW-MBE-2026-9041</span>
            <span class="sis-badge">FAR 19.7 DIVERSITY VENDOR</span>
          </div>
          <h1 class="text-2xl sm:text-4xl font-black text-white uppercase tracking-tight">
            Government &amp; Prime Contractor Capability Statement
          </h1>
          <p class="text-sm font-mono text-slate-400 mt-1">
            Sawtooth Industrial Systems LLC | Legal Business Entity (Boise, ID)
          </p>
        </div>
        <button onclick="window.print()" class="btn-sis-secondary text-xs shrink-0 flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
          PRINT / SAVE PDF
        </button>
      </div>
    </div>
  </section>

  <!-- Capability Statement Body -->
  <section class="py-12 bg-[#0F172A] border-b border-slate-800 text-slate-300 text-xs sm:text-sm">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">

      <!-- Executive Overview -->
      <div class="p-6 rounded-lg bg-slate-900 border border-slate-800 space-y-3">
        <h2 class="text-base sm:text-lg font-black text-white uppercase tracking-wider flex items-center gap-2">
          <span class="w-2.5 h-2.5 bg-amber-400 rounded-full"></span>
          Corporate Overview
        </h2>
        <p class="leading-relaxed">
          Sawtooth Industrial Systems LLC is an agile industrial control panel sourcing specialist, electrical power distribution provider, and certified Minority Business Enterprise (MBE) based in Boise, Idaho. Backed by 12+ years of commercial electrical distribution experience and an established network of certified UL 508A manufacturing facilities, we deliver high-spec industrial control panels, AI data center cooling distribution skids, and functional safety systems with industry-leading 8 to 12 week turnaround times.
        </p>
      </div>

      <!-- Procurement Identifiers & NAICS Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-6 rounded-lg bg-slate-900 border border-slate-800 space-y-4">
          <h2 class="text-base font-black text-white uppercase tracking-wider text-amber-400">
            Federal Procurement Data
          </h2>
          <div class="space-y-2 font-mono text-xs">
            <div class="flex justify-between border-b border-slate-800 pb-1.5">
              <span class="text-slate-400">CAGE Code:</span>
              <span class="text-white font-bold">9Z4A2</span>
            </div>
            <div class="flex justify-between border-b border-slate-800 pb-1.5">
              <span class="text-slate-400">Unique Entity ID (UEI/DUNS):</span>
              <span class="text-white font-bold">11-892-4821</span>
            </div>
            <div class="flex justify-between border-b border-slate-800 pb-1.5">
              <span class="text-slate-400">Business Structure:</span>
              <span class="text-white">Minority-Owned Small Business LLC</span>
            </div>
            <div class="flex justify-between border-b border-slate-800 pb-1.5">
              <span class="text-slate-400">MBE Certification:</span>
              <span class="text-emerald-400 font-bold">NW-MBE-2026-9041</span>
            </div>
            <div class="flex justify-between border-b border-slate-800 pb-1.5">
              <span class="text-slate-400">Certifying Body:</span>
              <span class="text-slate-200">Northwest Mountain MSDC</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">FAR 19.7 Subcontracting:</span>
              <span class="text-cyan-400 font-bold">Tier-1 &amp; Tier-2 Eligible</span>
            </div>
          </div>
        </div>

        <div class="p-6 rounded-lg bg-slate-900 border border-slate-800 space-y-4">
          <h2 class="text-base font-black text-white uppercase tracking-wider text-cyan-400">
            NAICS &amp; PSC Codes
          </h2>
          <div class="space-y-2 font-mono text-xs">
            <div>
              <span class="text-amber-400 font-bold">335314 (Primary)</span>
              <div class="text-slate-300">Relay &amp; Industrial Control Manufacturing</div>
            </div>
            <div>
              <span class="text-amber-400 font-bold">238210</span>
              <div class="text-slate-300">Electrical Contractors &amp; Other Wiring Installation</div>
            </div>
            <div>
              <span class="text-amber-400 font-bold">541330</span>
              <div class="text-slate-300">Engineering Services &amp; Control Drafting</div>
            </div>
            <div>
              <span class="text-amber-400 font-bold">423610</span>
              <div class="text-slate-300">Electrical Apparatus &amp; Equipment Wholesalers</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Core Competencies -->
      <div class="space-y-4">
        <h2 class="text-lg font-black text-white uppercase tracking-wider">
          Core Competencies
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="sis-card-enclosure p-5 space-y-2">
            <h3 class="font-bold text-white uppercase text-sm">UL 508A Control Panels</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Custom NEMA 1, 3R, 4, 4X, and 12 enclosures fabricated to customer CAD prints with Short-Circuit Current Ratings (SCCR) up to 100kA.
            </p>
          </div>
          <div class="sis-card-enclosure p-5 space-y-2">
            <h3 class="font-bold text-white uppercase text-sm">AI Data Center Skids</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              40kW to 120kW+ liquid-to-liquid CDU control panels, dual VFD lead/lag pumping, 500ms optical leak containment, and high-density RPPs.
            </p>
          </div>
          <div class="sis-card-enclosure p-5 space-y-2">
            <h3 class="font-bold text-white uppercase text-sm">Safety Instrumented Systems</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              IEC 61508 / 61511 functional safety lifecycle compliance, SIL 2 &amp; SIL 3 fail-safe hardware sourcing, and emergency shutdown integration.
            </p>
          </div>
        </div>
      </div>

      <!-- Key Differentiators -->
      <div class="p-6 rounded-lg bg-slate-900 border border-slate-800 space-y-4">
        <h2 class="text-lg font-black text-white uppercase tracking-wider text-emerald-400">
          Key Differentiators &amp; Past Performance Standards
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
          <div class="space-y-1">
            <div class="font-bold text-white uppercase flex items-center gap-1.5">
              <span class="text-amber-400 font-mono">01.</span>
              8-12 Week Fast-Track Delivery
            </div>
            <p class="text-slate-400">
              While multinational conglomerates quote 50 to 90+ week lead times, our multi-distributor sourcing and dedicated regional partner network delivers complete panels in 8 to 12 weeks.
            </p>
          </div>
          <div class="space-y-1">
            <div class="font-bold text-white uppercase flex items-center gap-1.5">
              <span class="text-amber-400 font-mono">02.</span>
              100% FAT Traveler Verification
            </div>
            <p class="text-slate-400">
              Every panel completes a 5-stage sign-off traveler: calibrated torque witnessing, 1000V DC Megger hi-pot isolation, point-to-point continuity, and live I/O simulation before shipping.
            </p>
          </div>
          <div class="space-y-1">
            <div class="font-bold text-white uppercase flex items-center gap-1.5">
              <span class="text-amber-400 font-mono">03.</span>
              Direct Owner Technical Accountability
            </div>
            <p class="text-slate-400">
              No junior account reps or bureaucratic delays. Every project is directly managed by the principal with 12+ years of wholesale electrical distribution and line-card experience.
            </p>
          </div>
          <div class="space-y-1">
            <div class="font-bold text-white uppercase flex items-center gap-1.5">
              <span class="text-amber-400 font-mono">04.</span>
              FAR 19.7 Prime Contractor Credits
            </div>
            <p class="text-slate-400">
              Certified MBE credentials enable prime EPC contractors (Turner, Mortenson, Bechtel) to fulfill strict federal and private diversity spend quotas on megafab and hyperscale builds.
            </p>
          </div>
        </div>
      </div>

      <!-- Contact & Submittal Desk -->
      <div class="p-6 rounded-lg bg-[#0B1120] border border-amber-500/30 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <div class="text-xs font-mono text-amber-400 uppercase font-bold">Government &amp; Prime Submittal Desk</div>
          <div class="text-sm font-bold text-white mt-1">Ready to include Sawtooth in your next project bid?</div>
          <div class="text-xs text-slate-400 mt-0.5">Send RFPs, drawings, and submittal packets to: procurement@siscontrols.com</div>
        </div>
        <div class="flex gap-3">
          <a href="/rfq/" class="btn-sis-rfq px-6 py-2.5 text-xs">
            SUBMIT BID INVITATION →
          </a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
