---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = "AI Data Center CDU & Power Skids | Sawtooth Industrial Systems";
const description = "Custom liquid cooling CDU control panels and remote power panels (RPP) for 40kW-120kW+ AI data center racks. Dual VFD pumping, 500ms leak containment, and DCIM integration in Boise, ID.";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": "https://siscontrols.com/capabilities/data-center-cdu-power/#service",
    "serviceType": "AI Data Center Thermal & Power Skid Fabrication",
    "name": "AI Data Center Liquid Cooling CDU & Modular Power Skids",
    "provider": {
      "@type": "Organization",
      "name": "Sawtooth Industrial Systems",
      "url": "https://siscontrols.com"
    },
    "description": "Custom Cooling Distribution Unit (CDU) control panels, secondary fluid network loops, 500ms optical leak containment, and high-density Remote Power Panels (RPP) for 40kW to 120kW+ AI clusters.",
    "areaServed": "United States",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "AI Data Center Capabilities",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Liquid-to-Liquid & Liquid-to-Air CDU Automation Panels"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "500ms Optical Leak Containment & Fast-Acting Valve Skids"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "High-Density Remote Power Panels (RPP) with BCM Monitoring"
          }
        }
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://siscontrols.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Capabilities",
        "item": "https://siscontrols.com/capabilities/ul-508a-panels/"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "AI Data Center CDU & Power Skids",
        "item": "https://siscontrols.com/capabilities/data-center-cdu-power/"
      }
    ]
  }
];
---

<BaseLayout title={title} description={description} schema={schema}>
  
<section class="bg-gradient-to-b from-[#0B1120] to-[#0F172A] pt-8 pb-16 border-b border-slate-800">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
<nav aria-label="Breadcrumb" class="mb-6">
<ol class="flex items-center gap-2 text-xs font-mono text-slate-400">
<li><a class="hover:text-amber-400 transition-colors" href="/">Home</a></li>
<li>/</li>
<li><a class="hover:text-amber-400 transition-colors" href="/capabilities/ul-508a-panels/">Capabilities</a></li>
<li>/</li>
<li aria-current="page" class="text-amber-400 font-semibold">AI Data Center CDU &amp; Power Skids</li>
</ol>
</nav>
<div class="space-y-4 max-w-4xl">
<div class="flex flex-wrap items-center gap-2">
<span class="sis-badge sis-badge--cyan">40kW-120kW+ RACK DENSITY</span>
<span class="sis-badge sis-badge--amber">OCP COMPLIANT ARCHITECTURE</span>
<span class="sis-badge">500ms LEAK CONTAINMENT</span>
</div>
<!-- Single H1 -->
<h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white uppercase leading-tight">
            AI Data Center Liquid Cooling CDU &amp; Modular Power Skids
          </h1>
<p class="text-base sm:text-lg text-slate-300 leading-relaxed font-normal">
            Precision Cooling Distribution Unit (CDU) control panels, secondary fluid network management, 500ms optical leak containment, and remote power panels (RPP) engineered for extreme-density AI accelerator clusters.
          </p>
</div>
</div>
</section>
<!-- Section 1: The AI Thermal Crisis -->
<section class="py-16 bg-[#0F172A] border-b border-slate-800">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
<div class="max-w-3xl space-y-2">
<span class="text-xs font-mono font-bold text-cyan-400 uppercase tracking-widest">Next-Gen AI Clusters</span>
<h2 class="text-2xl sm:text-3xl font-black text-white uppercase tracking-tight">
            The Thermal Crisis of Extreme-Density Compute (40kW to 120kW+ Per Rack)
          </h2>
<p class="text-sm text-slate-300 leading-relaxed">
            NVIDIA Blackwell GB200, NVL72, and custom ASIC hyperscaler clusters generate up to 132kW of thermal dissipation in a single server cabinet. Chilled-air CRAC systems have reached absolute physical heat-transfer limits, necessitating direct-to-chip (D2C) liquid cooling distribution.
          </p>
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs sm:text-sm">
<div class="p-6 rounded-lg bg-slate-900 border border-slate-800 space-y-2">
<div class="font-mono text-cyan-400 font-bold uppercase">40kW-120kW+ Density</div>
<h3 class="text-base font-bold text-white uppercase">Extreme Thermal Flux</h3>
<p class="text-slate-300 leading-relaxed">
              Chip surface temperatures must remain below 70°C under 100% compute loads. Liquid water/glycol provides 4,000x the volumetric heat capacity of air.
            </p>
</div>
<div class="p-6 rounded-lg bg-slate-900 border border-slate-800 space-y-2">
<div class="font-mono text-emerald-400 font-bold uppercase">Direct-to-Chip D2C</div>
<h3 class="text-base font-bold text-white uppercase">Precision Cold Plates</h3>
<p class="text-slate-300 leading-relaxed">
              Coolant delivered directly to microchannel copper cold plates across dual GPU/CPU packages, requiring stable supply pressures and micro-filtered fluids.
            </p>
</div>
<div class="p-6 rounded-lg bg-slate-900 border border-slate-800 space-y-2">
<div class="font-mono text-amber-400 font-bold uppercase">OCP Standardized</div>
<h3 class="text-base font-bold text-white uppercase">Open Rack v3 Compatible</h3>
<p class="text-slate-300 leading-relaxed">
              Engineered to Open Compute Project (OCP) liquid cooling guidelines for quick-disconnect couplings, secondary fluid networks, and manifold monitoring.
            </p>
</div>
</div>
</div>
</section>
 Section 2: CDU Control Architecture 
<section class="py-16 bg-[#0B1120] border-b border-slate-800">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
<div class="max-w-3xl space-y-2">
<span class="text-xs font-mono font-bold text-amber-500 uppercase tracking-widest">Fluid Dynamics Control</span>
<h2 class="text-2xl sm:text-3xl font-black text-white uppercase tracking-tight">
            Cooling Distribution Unit (CDU) Automation Panels
          </h2>
<p class="text-sm text-slate-300 leading-relaxed">
            Our CDU panels isolate the building Primary Facility Water System (FWS) from the clean Secondary Technology Cooling System (TCS) serving the compute racks.
          </p>
</div>
<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
<div class="sis-card-enclosure p-8 space-y-4">
<h3 class="text-xl font-bold text-white uppercase">Liquid-to-Liquid &amp; Liquid-to-Air Skid Architecture</h3>
<p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              Plate-and-frame stainless steel heat exchangers decouple facility water from the closed server manifold loop. Modulating 2-way and 3-way control valves on the FWS side regulate secondary supply temperatures to an exact setpoint of <span class="font-mono text-cyan-400 font-bold">±0.5°C</span> regardless of facility water fluctuations.
            </p>
<div class="font-mono text-xs text-slate-400 space-y-1.5 pt-2 border-t border-slate-800">
<div>• Variable Frequency Drive (VFD) pressure differential modulation</div>
<div>• Ultrasonic flow meter feedback tracking GPM per rack row</div>
<div>• Automated deaeration and expansion tank volume regulation</div>
</div>
</div>
<div class="sis-card-enclosure p-8 space-y-4">
<h3 class="text-xl font-bold text-white uppercase">Dual-Redundant Pumping (Lead/Lag Failover)</h3>
<p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              Equipped with dual stainless steel canned-motor or in-line centrifugal pumps driven by high-efficiency VFDs (ABB ACS580 or Rockwell PowerFlex). Integrated bump-less transfer logic switches from Lead to Lag pump within 100 milliseconds upon detecting motor fault, cavitation, or pressure drop.
            </p>
<div class="font-mono text-xs text-slate-400 space-y-1.5 pt-2 border-t border-slate-800">
<div>• Automated alternating runtime balancing motor wear</div>
<div>• Soft-starting profiles preventing water hammer pressure spikes</div>
<div>• Vibration transmitter monitoring for bearing wear diagnostics</div>
</div>
</div>
</div>
</div>
</section>
 Section 3: 500ms Optical Leak Containment 
<section class="py-16 bg-[#0F172A] border-b border-slate-800">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
<div class="max-w-3xl space-y-2">
<span class="text-xs font-mono font-bold text-red-400 uppercase tracking-widest">Mission-Critical Protection</span>
<h2 class="text-2xl sm:text-3xl font-black text-white uppercase tracking-tight">
            Secondary Fluid Network &amp; 500ms Optical Leak Containment
          </h2>
<p class="text-sm text-slate-300 leading-relaxed">
            In an AI data hall holding tens of millions of dollars in GPU hardware, a coolant leak is catastrophic. Our panels integrate sub-second multi-zone leak containment architectures.
          </p>
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs sm:text-sm">
<div class="p-6 rounded-lg bg-slate-900 border border-slate-800 space-y-3">
<div class="font-mono text-red-400 font-bold uppercase">&lt; 500ms Response</div>
<h3 class="text-base font-bold text-white uppercase">Optical &amp; Sensed Rope Arrays</h3>
<p class="text-slate-300 leading-relaxed">
              Optical liquid refractometers and continuous sensing ropes under server racks and skid drip pans detect as little as 1 mL of escaped coolant in under 500 milliseconds.
            </p>
</div>
<div class="p-6 rounded-lg bg-slate-900 border border-slate-800 space-y-3">
<div class="font-mono text-amber-400 font-bold uppercase">Automated Isolation</div>
<h3 class="text-base font-bold text-white uppercase">Fast-Closing Solenoids &amp; Valves</h3>
<p class="text-slate-300 leading-relaxed">
              Trips dry-break spring-return actuated valves and stops pump motors instantly, confining fluid release to the isolated server row and dumping secondary pressure.
            </p>
</div>
<div class="p-6 rounded-lg bg-slate-900 border border-slate-800 space-y-3">
<div class="font-mono text-emerald-400 font-bold uppercase">Fluid Health Monitoring</div>
<h3 class="text-base font-bold text-white uppercase">Conductivity &amp; pH Probes</h3>
<p class="text-slate-300 leading-relaxed">
              Continuous monitoring of secondary coolant conductivity, glycol percentage, and pH. Detects corrosion byproduct buildup before clogs impact cold plate channels.
            </p>
</div>
</div>
</div>
</section>
 Section 4: Remote Power Panels (RPP) 
<section class="py-16 bg-[#0B1120] border-b border-slate-800" id="rpp">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
<div class="max-w-3xl space-y-2">
<span class="text-xs font-mono font-bold text-amber-500 uppercase tracking-widest">Electrical Distribution</span>
<h2 class="text-2xl sm:text-3xl font-black text-white uppercase tracking-tight">
            High-Density Remote Power Panels (RPP) &amp; Modular Skids
          </h2>
<p class="text-sm text-slate-300 leading-relaxed">
            Delivering high-amperage 415V/480V distribution directly to high-density server rows and containerized modular power e-houses.
          </p>
</div>
<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
<div class="p-6 rounded-lg bg-slate-900 border border-slate-800 space-y-3">
<h3 class="text-lg font-bold text-white uppercase">Branch Circuit Monitoring (BCM)</h3>
<p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              Integrated solid-core CT arrays monitoring current, voltage, active power (kW), reactive power (kVAR), power factor, and total harmonic distortion (THD) on every individual branch breaker. Enables real-time rack PUE calculations and phase balancing.
            </p>
</div>
<div class="p-6 rounded-lg bg-slate-900 border border-slate-800 space-y-3">
<h3 class="text-lg font-bold text-white uppercase">Modular Containerized Power Skids</h3>
<p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              Pre-packaged structural skids uniting 480V automatic transfer switches (ATS), power distribution units (PDU), UPS battery interface breakers, and generator synchronizing switchgear for accelerated hyperscale campus construction.
            </p>
</div>
</div>
</div>
</section>
 Section 5: DCIM &amp; BMS Communications 
<section class="py-16 bg-[#0F172A] border-b border-slate-800">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
<div class="max-w-3xl space-y-2">
<span class="text-xs font-mono font-bold text-cyan-400 uppercase tracking-widest">Telemetry Protocols</span>
<h2 class="text-2xl sm:text-3xl font-black text-white uppercase tracking-tight">
            DCIM &amp; Building Management System (BMS) Communications
          </h2>
<p class="text-sm text-slate-300 leading-relaxed">
            Dual-homed network architectures isolate fast deterministic skid control from enterprise facility networks.
          </p>
</div>
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-xs font-mono">
<div class="p-4 rounded bg-slate-900 border border-slate-800 text-center space-y-1">
<div class="text-amber-400 font-bold">MODBUS TCP / IP</div>
<div class="text-slate-400">High-speed register polling for power meters &amp; VFDs</div>
</div>
<div class="p-4 rounded bg-slate-900 border border-slate-800 text-center space-y-1">
<div class="text-cyan-400 font-bold">BACNET / IP</div>
<div class="text-slate-400">Native BMS integration into Schneider, Vertiv, Johnson Controls</div>
</div>
<div class="p-4 rounded bg-slate-900 border border-slate-800 text-center space-y-1">
<div class="text-emerald-400 font-bold">SNMP v3</div>
<div class="text-slate-400">Encrypted trap notification for IT monitoring tools</div>
</div>
<div class="p-4 rounded bg-slate-900 border border-slate-800 text-center space-y-1">
<div class="text-white font-bold">MQTT SPARKPLUG B</div>
<div class="text-slate-400">Lightweight payload edge telemetry to enterprise lakes</div>
</div>
</div>
<div class="pt-6 text-center">
<a class="btn-sis-rfq px-8 py-3.5" href="/rfq/">
            REQUEST DATA CENTER SKID SUBMITTAL →
          </a>
</div>
</div>
</section>

<!-- Regional Hyperscale & Megafab Corridor Alignment -->
<section class="py-16 bg-[#0B1120] border-b border-slate-800" id="regional-hyperscale">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
<div class="max-w-3xl space-y-2">
<span class="text-xs font-mono font-bold text-amber-500 uppercase tracking-widest">Regional Deployment</span>
<h2 class="text-2xl sm:text-3xl font-black text-white uppercase tracking-tight">
            Intermountain West Hyperscale &amp; Megafab Support
          </h2>
<p class="text-sm text-slate-300 leading-relaxed">
            Direct regional engineering support for the expanding southern Idaho tech corridor, including the Meta Kuna Hyperscale campus and high-density semiconductor fabrication facilities.
          </p>
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs sm:text-sm">
<div class="p-6 rounded-lg bg-slate-900 border border-slate-800 space-y-3">
<div class="font-mono text-cyan-400 font-bold uppercase">Rapid Site Response</div>
<h3 class="text-base font-bold text-white uppercase">Boise Field Proximity</h3>
<p class="text-slate-300 leading-relaxed">
Headquartered on Executive Dr in Boise, our technical staff provides immediate on-site submittal reviews, contractor coordination, and commissioning walk-throughs across Ada and Canyon counties.
</p>
</div>
<div class="p-6 rounded-lg bg-slate-900 border border-slate-800 space-y-3">
<div class="font-mono text-emerald-400 font-bold uppercase">Thermal Skid Buffer Stocking</div>
<h3 class="text-base font-bold text-white uppercase">Sparks Corridor Speed</h3>
<p class="text-slate-300 leading-relaxed">
Rapid replenishment of stainless steel NEMA 4X enclosures and Modbus-connected VFDs via dedicated Sparks, NV and Salt Lake City freight routes, eliminating multi-month supply delays.
</p>
</div>
<div class="p-6 rounded-lg bg-slate-900 border border-slate-800 space-y-3">
<div class="font-mono text-amber-400 font-bold uppercase">OCP &amp; Open Rack v3</div>
<h3 class="text-base font-bold text-white uppercase">Standardized Manifolds</h3>
<p class="text-slate-300 leading-relaxed">
Panel builds tailored for standardized blind-mate fluid manifolds, fast-acting isolation solenoids, and continuous leak-rope monitoring compatible with Open Compute Project specs.
</p>
</div>
</div>
</div>
</section>

<!-- SECTION 6: INTERACTIVE SUBPANEL CUTAWAY & 12-COMPONENT BOM EXPLORER -->
<section class="py-16 bg-[#0F172A] border-b border-slate-800" id="cdu-cutaway">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
<div class="max-w-3xl space-y-2">
<span class="text-xs font-mono font-bold text-cyan-400 uppercase tracking-widest">Internal Engineering Architecture</span>
<h2 class="text-2xl sm:text-3xl font-black text-white uppercase tracking-tight">
            Interactive CDU Skid Subpanel Cutaway &amp; 12-Component BOM
          </h2>
<p class="text-sm text-slate-300 leading-relaxed">
            Examine the physical internal layout of our liquid cooling CDU automation panels. Click any coordinate pin or BOM line item to review technical ratings, dual VFD pump modulation, and fail-safe safety shutdown architecture.
          </p>
</div>
<!-- Cutaway Explorer Mount Point -->
<div class="w-full" id="cutaway-explorer-mount"></div>
</div>
</section>


  <script is:inline src="/assets/js/cutaway-explorer.js" defer></script>
</BaseLayout>
