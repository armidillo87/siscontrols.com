---
import BaseLayout from '@/layouts/BaseLayout.astro';
import siteConfig from '@/data/site-config.json';

const { business } = siteConfig;
---

<BaseLayout 
  title={`Leave a Review | ${business.name}`} 
  description="Client review and satisfaction feedback portal for Sawtooth Industrial Systems."
  hideStickyRfq={true}
>
  <section class="min-h-[80vh] py-20 bg-[#0F172A] flex items-center justify-center border-b border-slate-800">
    <div class="max-w-xl w-full mx-auto px-4 sm:px-6">
      <div class="sis-card-enclosure p-8 sm:p-12 space-y-6">
        <div class="text-center space-y-2">
          <span class="text-4xl inline-block">⭐</span>
          <h1 class="text-2xl sm:text-3xl font-black text-white uppercase tracking-tight">Your Feedback Matters</h1>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            How was your recent experience with our industrial control panel sourcing, rapid quoting, or project management?
          </p>
        </div>

        <!-- Step 1: Star Rating Selector -->
        <div id="star-selector" class="flex justify-center gap-3 sm:gap-4 py-4">
          {[1, 2, 3, 4, 5].map((star) => (
            <button 
              type="button" 
              class="star-btn text-3xl sm:text-4xl text-slate-600 hover:text-amber-400 focus:outline-none transition-colors" 
              data-rating={star}
              aria-label={`Rate ${star} stars`}
            >
              ★
            </button>
          ))}
        </div>

        <!-- Step 2A: High Rating Routing (4-5 Stars) -->
        <div id="high-rating-view" class="hidden text-center space-y-4 pt-4 border-t border-slate-800">
          <div class="p-5 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-300 text-xs sm:text-sm leading-relaxed">
            <strong>Thank you for the positive review!</strong>
            <p class="text-slate-300 mt-1">Please take 30 seconds to post your review on our public Google Business Profile so other facility and operations managers can find us.</p>
          </div>
          <a 
            href="https://google.com" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn-sis-rfq w-full text-center block text-xs sm:text-sm py-3"
          >
            SHARE ON GOOGLE REVIEW &rarr;
          </a>
        </div>

        <!-- Step 2B: Low Rating Private Feedback Form (1-3 Stars) -->
        <div id="low-rating-view" class="hidden space-y-4 pt-4 border-t border-slate-800">
          <div class="p-4 rounded-lg bg-amber-500/10 border border-amber-500/20 text-amber-300 text-xs leading-relaxed">
            We hold ourselves to strict delivery and quality standards. Please share what went wrong directly with ownership so we can resolve it immediately.
          </div>
          
          <form id="feedback-form" action="https://siscontrols.com/review" method="POST" class="space-y-4 text-xs font-mono">
            <div>
              <label for="feedback-name" class="block text-slate-300 font-bold mb-1 uppercase tracking-wider">Your Name *</label>
              <input 
                type="text" 
                id="feedback-name" 
                name="name" 
                required 
                placeholder="John Doe"
                class="w-full bg-[#0B1120] border border-slate-700 rounded-md px-3 py-2 text-white focus:outline-none focus:border-amber-500"
              />
            </div>
            <div>
              <label for="feedback-email" class="block text-slate-300 font-bold mb-1 uppercase tracking-wider">Email Address *</label>
              <input 
                type="email" 
                id="feedback-email" 
                name="email" 
                required 
                placeholder="jdoe@company.com"
                class="w-full bg-[#0B1120] border border-slate-700 rounded-md px-3 py-2 text-white focus:outline-none focus:border-amber-500"
              />
            </div>
            <div>
              <label for="feedback-comments" class="block text-slate-300 font-bold mb-1 uppercase tracking-wider">What Could We Have Done Better? *</label>
              <textarea 
                id="feedback-comments" 
                name="comments" 
                rows="4" 
                required 
                placeholder="Please describe your experience or issues encountered..."
                class="w-full bg-[#0B1120] border border-slate-700 rounded-md px-3 py-2 text-white focus:outline-none focus:border-amber-500"
              ></textarea>
            </div>
            <button 
              id="feedback-submit-btn"
              type="submit" 
              class="btn-sis-secondary w-full text-center py-3 text-xs uppercase tracking-wider"
            >
              SEND PRIVATE FEEDBACK TO OWNER &rarr;
            </button>
          </form>
          <div id="feedback-success" class="hidden p-4 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-center text-xs">
            Thank you. Your message has been sent directly to ownership.
          </div>
        </div>

      </div>
    </div>
  </section>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const starBtns = document.querySelectorAll('.star-btn');
      const highRatingView = document.getElementById('high-rating-view');
      const lowRatingView = document.getElementById('low-rating-view');
      const feedbackForm = document.getElementById('feedback-form');
      const feedbackSuccess = document.getElementById('feedback-success');

      starBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const rating = parseInt(btn.dataset.rating, 10);
          
          starBtns.forEach((b, i) => {
            if (i < rating) {
              b.classList.add('text-amber-400');
              b.classList.remove('text-slate-600');
            } else {
              b.classList.remove('text-amber-400');
              b.classList.add('text-slate-600');
            }
          });

          if (rating >= 4) {
            highRatingView.classList.remove('hidden');
            lowRatingView.classList.add('hidden');
          } else {
            lowRatingView.classList.remove('hidden');
            highRatingView.classList.add('hidden');
          }
        });
      });

      if (feedbackForm) {
        feedbackForm.addEventListener('submit', (e) => {
          e.preventDefault();
          feedbackForm.classList.add('hidden');
          feedbackSuccess.classList.remove('hidden');
        });
      }
    });
  </script>
</BaseLayout>
