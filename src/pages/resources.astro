<thead class="bg-slate-900 text-slate-400 uppercase border-b border-slate-700">
<tr>
<th class="py-3.5 px-4 font-bold text-white" scope="col">Component Category</th>
<th class="py-3.5 px-4 font-bold text-amber-400" scope="col">Legacy Baseline (A-B / Eaton)</th>
<th class="py-3.5 px-4 font-bold text-cyan-400" scope="col">Functional Drop-In Alternative</th>
<th class="py-3.5 px-4 font-bold" scope="col">Lead Time Delta</th>
<th class="py-3.5 px-4 font-bold text-emerald-400" scope="col">Cost Variance</th>
</tr>
</thead>
<tbody class="divide-y divide-slate-800">
<tr class="hover:bg-slate-800/40">
