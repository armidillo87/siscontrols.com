---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = "Contact Engineering & 24/7 Dispatch | Sawtooth Industrial Systems";
const description = "Contact Sawtooth Industrial Systems in Boise, Idaho. Direct engineering line (208) 555-0195, 24/7 emergency dispatch (208) 555-0190, and submittal inquiries.";
const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://siscontrols.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Contact",
      "item": "https://siscontrols.com/contact/"
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={schema}>
  
<section class="bg-gradient-to-b from-[#0B1120] to-[#0F172A] pt-8 pb-16 border-b border-slate-800">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
<nav aria-label="Breadcrumb" class="mb-6">
<ol class="flex items-center gap-2 text-xs font-mono text-slate-400">
<li><a class="hover:text-amber-400 transition-colors" href="/">Home</a></li>
<li>/</li>
<li aria-current="page" class="text-amber-400 font-semibold">Contact</li>
</ol>
</nav>
<div class="space-y-4 max-w-4xl">
<div class="flex flex-wrap items-center gap-2">
<span class="sis-badge sis-badge--amber">BOISE MANUFACTURING PLANT</span>
<span class="sis-badge sis-badge--emerald">24/7 FIELD DISPATCH</span>
<span class="sis-badge">72-HOUR FAST SUBMITTALS</span>
</div>
<!-- Single H1 -->
<h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white uppercase leading-tight">
            Contact Applications Engineering &amp; 24/7 Field Dispatch
          </h1>
<p class="text-base sm:text-lg text-slate-300 leading-relaxed font-normal">
            Direct engineering consultations, fast-track submittals, and round-the-clock emergency field dispatch from our Boise, Idaho manufacturing plant.
          </p>
</div>
</div>
</section>
 Facility &amp; Contact Channels 
<section class="py-16 bg-[#0F172A] border-b border-slate-800">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
<div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
<!-- Left Col: Facility & Communications -->
<div class="space-y-8">
<div class="space-y-3">
<span class="text-xs font-mono font-bold text-amber-500 uppercase tracking-widest">Operations &amp; Logistics</span>
<h2 class="text-2xl sm:text-3xl font-black text-white uppercase tracking-tight">
                Boise Operations &amp; Project Management Desk
              </h2>
<p class="text-sm text-slate-300 leading-relaxed">
                Headquartered in Boise, Idaho, Sawtooth Industrial Systems coordinates build-to-print panel fabrication, rapid component procurement, and regional partner shop dispatch across the Intermountain West.
              </p>
</div>
<!-- Address Card -->
<div class="p-6 rounded-lg bg-slate-900 border border-slate-800 space-y-3">
<div class="text-xs font-mono text-amber-400 font-bold uppercase tracking-wider">Boise Operations Headquarters</div>
<div class="text-white text-base font-bold">Sawtooth Industrial Systems LLC</div>
<div class="text-sm font-mono text-slate-300">
                11500 W Executive Dr<br/>
                Boise, ID 83713<br/>
                United States
              </div>
<div class="pt-2 text-xs font-mono text-slate-400 border-t border-slate-800 space-y-1">
<div><strong>Operating Hours:</strong> Mon – Fri: 6:00 AM – 5:00 PM MT</div>
<div><strong>Engineering Desk:</strong> Mon – Fri: 7:00 AM – 6:00 PM MT</div>
<div><strong>Emergency Dispatch:</strong> 24/7/365 Continuous Response</div>
</div>
</div>
<!-- Direct Lines -->
<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-mono">
<div class="p-5 rounded-lg bg-[#131D31] border border-slate-800 space-y-2">
<div class="text-emerald-400 font-bold uppercase flex items-center gap-1.5">
<span class="sis-led-dot sis-led-dot--emerald"></span>
                  24/7 Field Dispatch
                </div>
<div class="text-white text-base font-bold">
<a class="hover:text-amber-400 transition-colors" href="tel:2085550190">(208) 555-0190</a>
</div>
<div class="text-slate-400">Emergency plant turnarounds, commissioning, &amp; skid support</div>
</div>
<div class="p-5 rounded-lg bg-[#131D31] border border-slate-800 space-y-2">
<div class="text-amber-400 font-bold uppercase">Technical &amp; Sourcing Desk</div>
<div class="text-white text-base font-bold">
<a class="hover:text-amber-400 transition-colors" href="tel:2085550195">(208) 555-0195</a>
</div>
<div class="text-slate-400">Direct technical reviews with owner &amp; procurement lead</div>
</div>
<div class="p-5 rounded-lg bg-[#131D31] border border-slate-800 space-y-2">
<div class="text-cyan-400 font-bold uppercase">Submittals &amp; RFQs</div>
<div class="text-white text-sm font-bold">
<a class="hover:text-amber-400 transition-colors" href="mailto:rfq@siscontrols.com">rfq@siscontrols.com</a>
</div>
<div class="text-slate-400">24-48 hour turnaround for CAD &amp; BOM packages</div>
</div>
<div class="p-5 rounded-lg bg-[#131D31] border border-slate-800 space-y-2">
<div class="text-slate-300 font-bold uppercase">MBE Supplier Desk</div>
<div class="text-white text-sm font-bold">
<a class="hover:text-amber-400 transition-colors" href="mailto:mbe@siscontrols.com">mbe@siscontrols.com</a>
</div>
<div class="text-slate-400">FAR 19.7 prime contractor diversity compliance</div>
</div>
</div>
</div>
<!-- Right Col: Interactive Inquiry Form -->
<div>
<div class="sis-card-enclosure p-8 space-y-6">
<div class="space-y-1 pb-4 border-b border-slate-800">
<h2 class="text-xl font-bold text-white uppercase tracking-tight">
                  Submit an Engineering Inquiry
                </h2>
<p class="text-xs text-slate-400">
                  Direct intake for new panel builds, functional safety scoping, or prime contractor RFQs.
                </p>
</div>
<form class="space-y-4" id="engineering-inquiry-form" action="https://siscontrols.com/contact" method="POST" onsubmit="event.preventDefault(); document.getElementById('form-success-msg').classList.remove('hidden');">
<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
<div class="space-y-1">
<label class="block text-xs font-mono text-slate-300 uppercase" for="contact-name">Your Name *</label>
<input class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2.5 text-xs text-white focus:outline-none focus:border-amber-500 placeholder-slate-600" id="contact-name" name="name" placeholder="John Doe, PE" required="" type="text"/>
</div>
<div class="space-y-1">
<label class="block text-xs font-mono text-slate-300 uppercase" for="contact-company">Company / Prime *</label>
<input class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2.5 text-xs text-white focus:outline-none focus:border-amber-500 placeholder-slate-600" id="contact-company" name="company" placeholder="Mortenson / Bechtel / OEM" required="" type="text"/>
</div>
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
<div class="space-y-1">
<label class="block text-xs font-mono text-slate-300 uppercase" for="contact-email">Work Email *</label>
<input class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2.5 text-xs text-white focus:outline-none focus:border-amber-500 placeholder-slate-600" id="contact-email" name="email" placeholder="engineer@contractor.com" required="" type="email"/>
</div>
<div class="space-y-1">
<label class="block text-xs font-mono text-slate-300 uppercase" for="contact-phone">Direct Phone *</label>
<input class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2.5 text-xs text-white focus:outline-none focus:border-amber-500 placeholder-slate-600" id="contact-phone" name="phone" placeholder="(208) 555-0100" required="" type="tel"/>
</div>
</div>
<div class="space-y-1">
<label class="block text-xs font-mono text-slate-300 uppercase" for="inquiry-type">Inquiry Category</label>
<select class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2.5 text-xs text-white focus:outline-none focus:border-amber-500" id="inquiry-type" name="inquiry_type">
<option selected="" value="new_build">New UL 508A Control Panel Build (RFQ)</option>
<option value="data_center_cdu">AI Data Center Liquid Cooling CDU / Power Skid</option>
<option value="functional_safety">IEC 61511 Safety Instrumented System (SIS / SIL 2/3)</option>
<option value="plc_scada">PLC / SCADA Integration (Rockwell, Siemens, Ignition)</option>
<option value="mbe_subcontracting">MBE Prime Subcontracting / FAR 19.7 Diversity Spend</option>
<option value="emergency_dispatch">Emergency Field Service / Commissioning Support</option>
</select>
</div>
<div class="space-y-1">
<label class="block text-xs font-mono text-slate-300 uppercase" for="project-description">Project Scope &amp; Technical Details *</label>
<textarea class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2.5 text-xs text-white focus:outline-none focus:border-amber-500 placeholder-slate-600" id="project-description" name="description" placeholder="Please outline voltage, enclosure type, I/O channel count, timeline requirements, or drawing references..." required="" rows="4"></textarea>
</div>
<div class="p-3 rounded bg-slate-900/60 border border-slate-800 text-[11px] font-mono text-slate-400">
                  Note: For drawing files (.dwg, .dxf, .pdf), please submit directly to <a class="text-amber-400 underline" href="mailto:rfq@siscontrols.com">rfq@siscontrols.com</a> or use our full <a class="text-amber-400 underline" href="/rfq/">Interactive 5-Step RFQ Estimator</a>.
                </div>
<div class="hidden p-4 rounded bg-emerald-950/80 border border-emerald-500 text-xs font-mono text-emerald-300" id="form-success-msg">
                  ✓ Inquiry received! We will review your requirements and respond within 24-48 hours.
                </div>
<button class="btn-sis-rfq w-full py-3.5 text-xs" id="contact-submit-btn" type="submit">
                  SUBMIT ENGINEERING INQUIRY →
                </button>
</form>
</div>
</div>
</div>
</div>
</section>


</BaseLayout>
