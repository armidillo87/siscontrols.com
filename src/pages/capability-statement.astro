---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = "Capability Statement | Sawtooth Industrial Systems";
const description = "Commercial and industrial capability statement for Sawtooth Industrial Systems LLC in Boise, ID. Build-to-print industrial control panel sourcing, rapid component procurement, and partner UL 508A shop fabrication.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "Sawtooth Industrial Systems LLC",
    "url": "https://siscontrols.com/capability-statement/",
    "telephone": "+1-208-377-0010",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Boise",
      "addressRegion": "ID",
      "postalCode": "83713",
      "addressCountry": "US"
    },
    "description": "Industrial capability statement for build-to-print control panel sourcing, rapid component procurement, and certified partner shop fabrication."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://siscontrols.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Capability Statement",
        "item": "https://siscontrols.com/capability-statement/"
      }
    ]
  }
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <!-- Hero / Header Section -->
  <section class="bg-gradient-to-b from-[#0B1120] to-[#0F172A] pt-8 pb-12 border-b border-slate-800">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-xs font-mono text-slate-400">
          <li><a class="hover:text-amber-400 transition-colors" href="/">Home</a></li>
          <li>/</li>
          <li aria-current="page" class="text-amber-400 font-semibold">Capability Statement</li>
        </ol>
      </nav>

      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
        <div>
          <div class="flex flex-wrap items-center gap-2 mb-2">
            <span class="sis-badge sis-badge--amber">BUILD-TO-PRINT SOURCING</span>
            <span class="sis-badge sis-badge--emerald">MINORITY-OWNED ENTERPRISE</span>
            <span class="sis-badge">UL 508A PARTNER FABRICATION</span>
          </div>
          <h1 class="text-2xl sm:text-4xl font-black text-white uppercase tracking-tight">
            Industrial Sourcing &amp; Panel Fabrication Capability Statement
          </h1>
          <p class="text-sm font-mono text-slate-400 mt-1">
            Sawtooth Industrial Systems LLC | Commercial Sourcing &amp; Partner Assembly (Boise, ID)
          </p>
        </div>
        <button onclick="window.print()" class="btn-sis-secondary text-xs shrink-0 flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
          PRINT / SAVE PDF
        </button>
      </div>
    </div>
  </section>

  <!-- Capability Statement Body -->
  <section class="py-12 bg-[#0F172A] border-b border-slate-800 text-slate-300 text-xs sm:text-sm">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">

      <!-- Executive Overview -->
      <div class="p-6 rounded-lg bg-slate-900 border border-slate-800 space-y-3">
        <h2 class="text-base sm:text-lg font-black text-white uppercase tracking-wider flex items-center gap-2">
          <span class="w-2.5 h-2.5 bg-amber-400 rounded-full"></span>
          Corporate Overview
        </h2>
        <p class="leading-relaxed">
          Sawtooth Industrial Systems LLC is an agile industrial control panel sourcing specialist and electrical component supply provider based in Boise, Idaho. Backed by 12+ years of commercial electrical distribution experience and an established network of certified UL 508A manufacturing facilities, we deliver high-spec industrial control panels, cooling distribution skids, and equipment controls with industry-leading 8 to 12 week turnaround times.
        </p>
      </div>

      <!-- Procurement Identifiers & NAICS Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-6 rounded-lg bg-slate-900 border border-slate-800 space-y-4">
          <h2 class="text-base font-black text-white uppercase tracking-wider text-amber-400">
            Commercial &amp; Procurement Profile
          </h2>
          <div class="space-y-2 font-mono text-xs">
            <div class="flex justify-between border-b border-slate-800 pb-1.5">
              <span class="text-slate-400">Entity:</span>
              <span class="text-white font-bold">Sawtooth Industrial Systems LLC</span>
            </div>
            <div class="flex justify-between border-b border-slate-800 pb-1.5">
              <span class="text-slate-400">Business Classification:</span>
              <span class="text-white">Minority-Owned Small Business</span>
            </div>
            <div class="flex justify-between border-b border-slate-800 pb-1.5">
              <span class="text-slate-400">Headquarters:</span>
              <span class="text-white">Boise, Idaho 83713</span>
            </div>
            <div class="flex justify-between border-b border-slate-800 pb-1.5">
              <span class="text-slate-400">Operating Scope:</span>
              <span class="text-slate-200">Build-to-Print Sourcing &amp; Partner Assembly</span>
            </div>
            <div class="flex justify-between border-b border-slate-800 pb-1.5">
              <span class="text-slate-400">UL 508A Standards:</span>
              <span class="text-emerald-400 font-bold">Certified Partner Shop Network</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">RFQ Turnaround SLA:</span>
              <span class="text-cyan-400 font-bold">24 to 48 Hours</span>
            </div>
          </div>
        </div>

        <div class="p-6 rounded-lg bg-slate-900 border border-slate-800 space-y-4">
          <h2 class="text-base font-black text-white uppercase tracking-wider text-cyan-400">
            Target NAICS &amp; Industry Codes
          </h2>
          <div class="space-y-2 font-mono text-xs">
            <div>
              <span class="text-amber-400 font-bold">335314 (Primary)</span>
              <div class="text-slate-300">Relay &amp; Industrial Control Manufacturing</div>
            </div>
            <div>
              <span class="text-amber-400 font-bold">423610</span>
              <div class="text-slate-300">Electrical Apparatus &amp; Equipment Wholesalers</div>
            </div>
            <div>
              <span class="text-amber-400 font-bold">541330</span>
              <div class="text-slate-300">Engineering Services &amp; Control Drafting</div>
            </div>
            <div>
              <span class="text-amber-400 font-bold">238210</span>
              <div class="text-slate-300">Electrical Contractors &amp; Other Wiring Installation</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Core Competencies -->
      <div class="space-y-4">
        <h2 class="text-lg font-black text-white uppercase tracking-wider">
          Core Competencies
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="sis-card-enclosure p-5 space-y-2">
            <h3 class="font-bold text-white uppercase text-sm">UL 508A Control Panels</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Custom NEMA 1, 3R, 4, 4X, and 12 enclosures fabricated to customer CAD prints with Short-Circuit Current Ratings (SCCR) up to 100kA through partner shops.
            </p>
          </div>
          <div class="sis-card-enclosure p-5 space-y-2">
            <h3 class="font-bold text-white uppercase text-sm">Industrial Cooling &amp; Skids</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Enclosure climate control, closed-loop cooling skids, VFD pumping controls, and high-density distribution panels.
            </p>
          </div>
          <div class="sis-card-enclosure p-5 space-y-2">
            <h3 class="font-bold text-white uppercase text-sm">Safety Systems &amp; PLCs</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Fail-safe hardware sourcing, emergency stop circuits, interlocking logic, and drop-in component cross-referencing.
            </p>
          </div>
        </div>
      </div>

      <!-- Key Differentiators -->
      <div class="p-6 rounded-lg bg-slate-900 border border-slate-800 space-y-4">
        <h2 class="text-lg font-black text-white uppercase tracking-wider text-emerald-400">
          Key Differentiators &amp; Operating Standards
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
          <div class="space-y-1">
            <div class="font-bold text-white uppercase flex items-center gap-1.5">
              <span class="text-amber-400 font-mono">01.</span>
              8-12 Week Fast-Track Delivery
            </div>
            <p class="text-slate-400">
              While multinational conglomerates quote 50 to 90+ week lead times, our multi-distributor sourcing and dedicated regional partner network delivers complete panels in 8 to 12 weeks.
            </p>
          </div>
          <div class="space-y-1">
            <div class="font-bold text-white uppercase flex items-center gap-1.5">
              <span class="text-amber-400 font-mono">02.</span>
              100% FAT Traveler Verification
            </div>
            <p class="text-slate-400">
              Every panel completes a 5-stage sign-off traveler: calibrated torque witnessing, 1000V DC Megger hi-pot isolation, point-to-point continuity, and live I/O simulation before shipping.
            </p>
          </div>
          <div class="space-y-1">
            <div class="font-bold text-white uppercase flex items-center gap-1.5">
              <span class="text-amber-400 font-mono">03.</span>
              Direct Owner Technical Accountability
            </div>
            <p class="text-slate-400">
              No junior account reps or bureaucratic delays. Every project is directly managed by the principal with 12+ years of wholesale electrical distribution and line-card experience.
            </p>
          </div>
          <div class="space-y-1">
            <div class="font-bold text-white uppercase flex items-center gap-1.5">
              <span class="text-amber-400 font-mono">04.</span>
              Small Business Agility
            </div>
            <p class="text-slate-400">
              As an agile, minority-owned small business enterprise, Sawtooth provides prime contractors and facilities with responsive sourcing and transparent, certified partner execution.
            </p>
          </div>
        </div>
      </div>

      <!-- Contact & Submittal Desk -->
      <div class="p-6 rounded-lg bg-[#0B1120] border border-amber-500/30 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <div class="text-xs font-mono text-amber-400 uppercase font-bold">Submittal &amp; Quoting Desk</div>
          <div class="text-sm font-bold text-white mt-1">Ready to quote your next control panel package?</div>
          <div class="text-xs text-slate-400 mt-0.5">Send drawings, BOMs, and specifications to: rfq@siscontrols.com</div>
        </div>
        <div class="flex gap-3">
          <a href="/rfq/" class="btn-sis-rfq px-6 py-2.5 text-xs">
            SUBMIT PANEL RFQ →
          </a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
