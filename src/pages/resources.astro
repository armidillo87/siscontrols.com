---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = "Engineering Submittals & Resources | Sawtooth Industrial Systems";
const description = "Technical engineering resource center: UL 508A Supplement SB calculation manual, NFPA 79 compliance checklists, EPLAN 3D submittal formats, and NEMA vs IP rating guides.";
const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://siscontrols.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Resources",
      "item": "https://siscontrols.com/resources/"
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={schema}>
  
<section class="bg-gradient-to-b from-[#0B1120] to-[#0F172A] pt-8 pb-16 border-b border-slate-800">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
<nav aria-label="Breadcrumb" class="mb-6">
<ol class="flex items-center gap-2 text-xs font-mono text-slate-400">
<li><a class="hover:text-amber-400 transition-colors" href="/">Home</a></li>
<li>/</li>
<li aria-current="page" class="text-amber-400 font-semibold">Resources</li>
</ol>
</nav>
<div class="space-y-4 max-w-4xl">
<div class="flex flex-wrap items-center gap-2">
<span class="sis-badge sis-badge--amber">SUBMITTAL RESOURCE CENTER</span>
<span class="sis-badge">CALCULATION MANUALS</span>
<span class="sis-badge sis-badge--cyan">NFPA 79 CHECKLISTS</span>
</div>
<!-- Single H1 -->
<h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white uppercase leading-tight">
            Engineering Submittals &amp; Technical Resource Center
          </h1>
<p class="text-base sm:text-lg text-slate-300 leading-relaxed font-normal">
            Downloadable specification sheets, calculation guides, code compliance checklists, and digital twin standards for industrial control panels, safety systems, and AI data center power distribution.
          </p>
</div>
</div>
</section>
 Downloadable Whitepapers &amp; Guides 
<section class="py-16 bg-[#0F172A] border-b border-slate-800">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
<div class="max-w-3xl space-y-2">
<span class="text-xs font-mono font-bold text-amber-500 uppercase tracking-widest">Technical Publications</span>
<h2 class="text-2xl sm:text-3xl font-black text-white uppercase tracking-tight">
            Engineering Guides &amp; Submittal Documentation
          </h2>
<p class="text-sm text-slate-300 leading-relaxed">
            Practical technical guides, calculation frameworks, and submittal checklists built for electrical contractors, panel builders, and project engineers.
          </p>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
<!-- Guide 1: SCCR -->
<div class="sis-card-enclosure p-6 flex flex-col justify-between" id="sccr-guide">
<div class="space-y-3">
<span class="sis-badge sis-badge--amber text-[10px]">WHITEPAPER • 24 PAGES</span>
<h3 class="text-lg font-bold text-white uppercase">UL 508A Supplement SB Calculation Manual</h3>
<p class="text-xs text-slate-300 leading-relaxed">
                Step-by-step mathematical guide to determining panel Short-Circuit Current Ratings. Covers Table SB4.1 default ratings, tested combination ratings, current-limiting fuse cutoff curves, and eliminating power distribution block bottlenecks.
              </p>
</div>
<div class="pt-4 mt-4 border-t border-slate-800 flex items-center justify-between">
<span class="font-mono text-xs text-slate-400">PDF SPEC (3.4 MB)</span>
<a class="text-xs font-bold text-amber-400 hover:text-amber-300" href="/rfq/">REQUEST COPY →</a>
</div>
</div>
<!-- Guide 2: NFPA 79 -->
<div class="sis-card-enclosure p-6 flex flex-col justify-between" id="nfpa79">
<div class="space-y-3">
<span class="sis-badge sis-badge--cyan text-[10px]">CHECKLIST • 18 PAGES</span>
<h3 class="text-lg font-bold text-white uppercase">NFPA 79 Industrial Machinery Compliance Checklist</h3>
<p class="text-xs text-slate-300 leading-relaxed">
                Comprehensive 2024/2026 code review covering supply circuit disconnects, door mechanical interlocking requirements, operator interface pushbuttons, color-coding conventions, and equipment grounding conductor sizing.
              </p>
</div>
<div class="pt-4 mt-4 border-t border-slate-800 flex items-center justify-between">
<span class="font-mono text-xs text-slate-400">PDF SPEC (2.1 MB)</span>
<a class="text-xs font-bold text-amber-400 hover:text-amber-300" href="/rfq/">REQUEST COPY →</a>
</div>
</div>
<!-- Guide 3: EPLAN CAD -->
<div class="sis-card-enclosure p-6 flex flex-col justify-between" id="cad">
<div class="space-y-3">
<span class="sis-badge sis-badge--emerald text-[10px]">CAD FORMATS • SPEC SHEET</span>
<h3 class="text-lg font-bold text-white uppercase">EPLAN Pro Panel 3D Digital Twin Formats</h3>
<p class="text-xs text-slate-300 leading-relaxed">
                Overview of deliverable submittal packages provided on every project: intelligent 3D STEP cabinet models, DWG multi-sheet schematics, bill of materials spreadsheets, and automated wire terminal connection diagrams.
              </p>
</div>
<div class="pt-4 mt-4 border-t border-slate-800 flex items-center justify-between">
<span class="font-mono text-xs text-slate-400">ZIP BUNDLE (12 MB)</span>
<a class="text-xs font-bold text-amber-400 hover:text-amber-300" href="/rfq/">REQUEST SAMPLES →</a>
</div>
</div>
<!-- Guide 4: IEC 61511 Functional Safety -->
<div class="sis-card-enclosure p-6 flex flex-col justify-between">
<div class="space-y-3">
<span class="sis-badge text-[10px]">ENGINEERING GUIDE • 32 PAGES</span>
<h3 class="text-lg font-bold text-white uppercase">IEC 61511 Safety Lifecycle &amp; SRS Template</h3>
<p class="text-xs text-slate-300 leading-relaxed">
                Standard Safety Requirement Specification (SRS) template outlining hazard analysis, target SIL assignment, PFDavg calculations, and proof test documentation for process safety systems.
              </p>
</div>
<div class="pt-4 mt-4 border-t border-slate-800 flex items-center justify-between">
<span class="font-mono text-xs text-slate-400">PDF SPEC (4.2 MB)</span>
<a class="text-xs font-bold text-amber-400 hover:text-amber-300" href="/rfq/">REQUEST COPY →</a>
</div>
</div>
<!-- Guide 5: Data Center CDU -->
<div class="sis-card-enclosure p-6 flex flex-col justify-between">
<div class="space-y-3">
<span class="sis-badge sis-badge--cyan text-[10px]">AI DATA CENTER SPEC</span>
<h3 class="text-lg font-bold text-white uppercase">AI Data Center CDU Thermal Control Standard</h3>
<p class="text-xs text-slate-300 leading-relaxed">
                Engineering specification for liquid-to-liquid cooling distribution skids, secondary fluid network instrumentation, OCP manifold telemetry, and sub-500ms optical leak containment protocols.
              </p>
</div>
<div class="pt-4 mt-4 border-t border-slate-800 flex items-center justify-between">
<span class="font-mono text-xs text-slate-400">PDF SPEC (2.8 MB)</span>
<a class="text-xs font-bold text-amber-400 hover:text-amber-300" href="/rfq/">REQUEST COPY →</a>
</div>
</div>
<!-- Guide 6: Enclosure Sizing Matrix -->
<div class="sis-card-enclosure p-6 flex flex-col justify-between">
<div class="space-y-3">
<span class="sis-badge text-[10px]">REFERENCE MATRIX</span>
<h3 class="text-lg font-bold text-white uppercase">Thermodynamic Sizing &amp; Heat Dissipation Guide</h3>
<p class="text-xs text-slate-300 leading-relaxed">
                Engineering charts correlating internal component wattage heat loss (Q(watts)) with enclosure surface area ($A$) and closed-loop air conditioner BTU requirements.
              </p>
</div>
<div class="pt-4 mt-4 border-t border-slate-800 flex items-center justify-between">
<span class="font-mono text-xs text-slate-400">PDF SPEC (1.8 MB)</span>
<a class="text-xs font-bold text-amber-400 hover:text-amber-300" href="/rfq/">REQUEST COPY →</a>
</div>
</div>
</div>
</div>
</section>
 Industrial Reference Tables 
<section class="py-16 bg-[#0B1120] border-b border-slate-800">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
<div class="max-w-3xl space-y-2">
<span class="text-xs font-mono font-bold text-amber-500 uppercase tracking-widest">Quick Reference</span>
<h2 class="text-2xl sm:text-3xl font-black text-white uppercase tracking-tight">
            NEMA vs. IEC IP Environmental Enclosure Conversion
          </h2>
<p class="text-sm text-slate-300 leading-relaxed">
            Note: While NEMA ratings can be converted to IP equivalents, IP ratings do not test for corrosion or oil resistance and cannot be directly inverted to NEMA.
          </p>
</div>
<div class="overflow-x-auto rounded-lg border border-slate-700/80 shadow-2xl">
<table class="w-full text-left text-xs font-mono text-slate-300">
<thead class="bg-slate-900 text-slate-400 uppercase border-b border-slate-700">
<tr>
<th class="py-3.5 px-4 font-bold" scope="col">NEMA Type</th>
<th class="py-3.5 px-4 font-bold text-amber-400" scope="col">Equivalent IP</th>
<th class="py-3.5 px-4 font-bold" scope="col">Indoor / Outdoor</th>
<th class="py-3.5 px-4 font-bold" scope="col">Environmental Protection Capabilities</th>
</tr>
</thead>
<tbody class="divide-y divide-slate-800">
<tr class="hover:bg-slate-800/40">
<td class="py-3 px-4 font-bold text-white">NEMA 1</td>
<td class="py-3 px-4 text-amber-400">IP20</td>
<td class="py-3 px-4">Indoor</td>
<td class="py-3 px-4 text-slate-400">General purpose; protection against accidental contact and falling dirt</td>
</tr>
<tr class="hover:bg-slate-800/40">
<td class="py-3 px-4 font-bold text-white">NEMA 3R</td>
<td class="py-3 px-4 text-amber-400">IP24</td>
<td class="py-3 px-4">Outdoor</td>
<td class="py-3 px-4 text-slate-400">Rainproof, sleet-resistant, external ice formation drainage</td>
</tr>
<tr class="hover:bg-slate-800/40">
<td class="py-3 px-4 font-bold text-white">NEMA 4</td>
<td class="py-3 px-4 text-amber-400">IP66</td>
<td class="py-3 px-4">Indoor / Outdoor</td>
<td class="py-3 px-4 text-slate-400">Watertight &amp; dust-tight; resists 65 GPM high-pressure water hose streams</td>
</tr>
<tr class="hover:bg-slate-800/40">
<td class="py-3 px-4 font-bold text-white">NEMA 4X</td>
<td class="py-3 px-4 text-amber-400">IP66 / IP69K</td>
<td class="py-3 px-4">Indoor / Outdoor</td>
<td class="py-3 px-4 text-slate-400">Corrosion-resistant 304/316 stainless; caustic chemical washdown</td>
</tr>
<tr class="hover:bg-slate-800/40">
<td class="py-3 px-4 font-bold text-white">NEMA 12</td>
<td class="py-3 px-4 text-amber-400">IP54 / IP55</td>
<td class="py-3 px-4">Indoor</td>
<td class="py-3 px-4 text-slate-400">Dust, lint, fibers, and circulating non-corrosive oil and coolant seepage</td>
</tr>
</tbody>
</table>
</div>
</div>
</section>

<!-- Component Cross-Reference & Engineering Arbitrage Matrix -->
<section class="py-16 bg-[#0F172A] border-b border-slate-800" id="cross-reference">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
<div class="max-w-3xl space-y-2">
<span class="text-xs font-mono font-bold text-cyan-400 uppercase tracking-widest">Supply Chain Velocity</span>
<h2 class="text-2xl sm:text-3xl font-black text-white uppercase tracking-tight">
            Component Cross-Reference &amp; Lead-Time Mitigation Matrix
          </h2>
<p class="text-sm text-slate-300 leading-relaxed">
            Long factory backorders on legacy brands delay critical path commissioning. We engineer drop-in functional equivalents that preserve UL 508A Supplement SB SCCR ratings while cutting lead times from 40 weeks to days.
          </p>
</div>
<div class="overflow-x-auto rounded-lg border border-slate-700/80 shadow-2xl">
