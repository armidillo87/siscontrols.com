---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = "Contact Sourcing & Project Desk | Sawtooth Industrial Systems";
const description = "Contact Sawtooth Industrial Systems in Boise, Idaho. Direct sourcing desk, fast-track submittals, and build-to-print panel inquiries.";
const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://siscontrols.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Contact",
      "item": "https://siscontrols.com/contact/"
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={schema}>
  
<section class="bg-gradient-to-b from-[#0B1120] to-[#0F172A] pt-8 pb-16 border-b border-slate-800">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
<nav aria-label="Breadcrumb" class="mb-6">
<ol class="flex items-center gap-2 text-xs font-mono text-slate-400">
<li><a class="hover:text-amber-400 transition-colors" href="/">Home</a></li>
<li>/</li>
<li aria-current="page" class="text-amber-400 font-semibold">Contact</li>
</ol>
</nav>
<div class="space-y-4 max-w-4xl">
<div class="flex flex-wrap items-center gap-2">
<span class="sis-badge sis-badge--amber">BOISE SOURCING DESK</span>
<span class="sis-badge sis-badge--emerald">MINORITY-OWNED ENTERPRISE</span>
<span class="sis-badge">FAST SUBMITTALS (24-48 HR)</span>
</div>
<!-- Single H1 -->
<h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white uppercase leading-tight">
            Contact Sourcing Desk &amp; Project Inquiries
          </h1>
<p class="text-base sm:text-lg text-slate-300 leading-relaxed font-normal">
            Direct component sourcing, build-to-print panel quotations, and rapid submittal turnarounds from our Boise, Idaho operations desk.
          </p>
</div>
</div>
</section>
<!-- Facility & Contact Channels -->
<section class="py-16 bg-[#0F172A] border-b border-slate-800">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
<div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
<!-- Left Col: Facility & Communications -->
<div class="space-y-8">
<div class="space-y-3">
<span class="text-xs font-mono font-bold text-amber-500 uppercase tracking-widest">Operations &amp; Sourcing</span>
<h2 class="text-2xl sm:text-3xl font-black text-white uppercase tracking-tight">
                Boise Operations &amp; Project Desk
              </h2>
<p class="text-sm text-slate-300 leading-relaxed">
                Headquartered in Boise, Idaho, Sawtooth Industrial Systems coordinates build-to-print panel fabrication, rapid component procurement, and regional partner shop assembly across the Intermountain West.
              </p>
</div>
<!-- Address Card -->
<div class="p-6 rounded-lg bg-slate-900 border border-slate-800 space-y-3">
<div class="text-xs font-mono text-amber-400 font-bold uppercase tracking-wider">Boise Operations Desk</div>
<div class="text-white text-base font-bold">Sawtooth Industrial Systems LLC</div>
<div class="text-sm font-mono text-slate-300">
                Boise, ID 83713<br/>
                Serving Idaho &amp; the Intermountain West
              </div>
<div class="pt-2 text-xs font-mono text-slate-400 border-t border-slate-800 space-y-1">
<div><strong>Operating Hours:</strong> Mon - Fri: 7:30 AM - 5:00 PM MT</div>
<div><strong>Sourcing Desk:</strong> Mon - Fri: 7:30 AM - 5:00 PM MT</div>
<div><strong>Inquiries &amp; RFQs:</strong> 24/7 Intake via Web &amp; Email</div>
</div>
</div>
<!-- Direct Lines -->
<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-mono">
<div class="p-5 rounded-lg bg-[#131D31] border border-slate-800 space-y-2">
<div class="text-amber-400 font-bold uppercase">Sourcing &amp; Project Desk</div>
<div class="text-white text-base font-bold">
<a class="hover:text-amber-400 transition-colors" href="mailto:rfq@siscontrols.com">rfq@siscontrols.com</a>
</div>
<div class="text-slate-400">Direct technical reviews with owner &amp; sourcing specialist</div>
</div>
<div class="p-5 rounded-lg bg-[#131D31] border border-slate-800 space-y-2">
<div class="text-cyan-400 font-bold uppercase">Submittals &amp; RFQs</div>
<div class="text-white text-base font-bold">
<a class="hover:text-amber-400 transition-colors" href="/rfq/">Launch RFQ Wizard</a>
</div>
<div class="text-slate-400">24-48 hour turnaround for CAD &amp; BOM packages</div>
</div>
<div class="p-5 rounded-lg bg-[#131D31] border border-slate-800 space-y-2">
<div class="text-slate-300 font-bold uppercase">Minority Business Partner</div>
<div class="text-emerald-400 text-sm font-bold">Minority-Owned Small Business</div>
<div class="text-slate-400">Supplier diversity alignment for regional industrial projects</div>
</div>
<div class="p-5 rounded-lg bg-[#131D31] border border-slate-800 space-y-2">
<div class="text-emerald-400 font-bold uppercase flex items-center gap-1.5">
<span class="sis-led-dot sis-led-dot--emerald"></span>
                  Partner Panel Network
                </div>
<div class="text-white text-sm font-bold">UL 508A Fabrication Partners</div>
<div class="text-slate-400">100% Factory Acceptance Testing &amp; certified labeling</div>
</div>
</div>
</div>
</div>
<!-- Right Col: Interactive Inquiry Form -->
<div>
<div class="sis-card-enclosure p-8 space-y-6">
<div class="space-y-1 pb-4 border-b border-slate-800">
<h2 class="text-xl font-bold text-white uppercase tracking-tight">
                  Submit an Engineering Inquiry
                </h2>
<p class="text-xs text-slate-400">
                  Direct intake for new panel builds, functional safety scoping, or prime contractor RFQs.
                </p>
</div>
<form class="space-y-4" id="engineering-inquiry-form" action="https://siscontrols.com/contact" method="POST" onsubmit="event.preventDefault(); document.getElementById('form-success-msg').classList.remove('hidden');">
<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
<div class="space-y-1">
<label class="block text-xs font-mono text-slate-300 uppercase" for="contact-name">Your Name *</label>
<input class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2.5 text-xs text-white focus:outline-none focus:border-amber-500 placeholder-slate-600" id="contact-name" name="name" placeholder="John Doe" required="" type="text"/>
</div>
<div class="space-y-1">
<label class="block text-xs font-mono text-slate-300 uppercase" for="contact-company">Company / Prime *</label>
<input class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2.5 text-xs text-white focus:outline-none focus:border-amber-500 placeholder-slate-600" id="contact-company" name="company" placeholder="Contractor / Facility / OEM" required="" type="text"/>
</div>
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
<div class="space-y-1">
<label class="block text-xs font-mono text-slate-300 uppercase" for="contact-email">Work Email *</label>
<input class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2.5 text-xs text-white focus:outline-none focus:border-amber-500 placeholder-slate-600" id="contact-email" name="email" placeholder="name@company.com" required="" type="email"/>
</div>
<div class="space-y-1">
<label class="block text-xs font-mono text-slate-300 uppercase" for="contact-phone">Direct Phone *</label>
<input class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2.5 text-xs text-white focus:outline-none focus:border-amber-500 placeholder-slate-600" id="contact-phone" name="phone" placeholder="(208) 555-0100" required="" type="tel"/>
</div>
</div>
<div class="space-y-1">
<label class="block text-xs font-mono text-slate-300 uppercase" for="inquiry-type">Inquiry Category</label>
<select class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2.5 text-xs text-white focus:outline-none focus:border-amber-500" id="inquiry-type" name="inquiry_type">
<option selected="" value="new_build">Build-to-Print UL 508A Control Panel (RFQ)</option>
<option value="data_center_cdu">AI Data Center Liquid Cooling CDU / Power Skid</option>
<option value="functional_safety">Safety Interlock &amp; Control System Sourcing</option>
<option value="component_sourcing">Hard-to-Find Component &amp; VFD Sourcing</option>
<option value="mbe_subcontracting">Minority Business Supplier Partnership</option>
<option value="expedited_sourcing">Expedited Component / Panel Sourcing</option>
</select>
</div>
<div class="space-y-1">
<label class="block text-xs font-mono text-slate-300 uppercase" for="project-description">Project Scope &amp; Technical Details *</label>
<textarea class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2.5 text-xs text-white focus:outline-none focus:border-amber-500 placeholder-slate-600" id="project-description" name="description" placeholder="Please outline voltage, enclosure type, component requirements, timeline, or drawing references..." required="" rows="4"></textarea>
</div>
<div class="p-3 rounded bg-slate-900/60 border border-slate-800 text-[11px] font-mono text-slate-400">
                  Note: For drawing files (.dwg, .dxf, .pdf), please submit directly to <a class="text-amber-400 underline" href="mailto:rfq@siscontrols.com">rfq@siscontrols.com</a> or use our full <a class="text-amber-400 underline" href="/rfq/">Interactive 5-Step RFQ Estimator</a>.
                </div>
<div class="hidden p-4 rounded bg-emerald-950/80 border border-emerald-500 text-xs font-mono text-emerald-300" id="form-success-msg">
                  ✓ Inquiry received! We will review your requirements and respond within 24-48 hours.
                </div>
<button class="btn-sis-rfq w-full py-3.5 text-xs" id="contact-submit-btn" type="submit">
                  SUBMIT SOURCING INQUIRY →
                </button>
</form>
</div>
</div>
</div>
</div>
</section>


</BaseLayout>
